      "script": "",
      "properties": {
        "enabled": true,
        "locked": true,
        "style": "transparent",
        "text": "Nothing persists between calls. The weights are frozen, so whatever a chat appears to remember about you was re-sent as text in that same request, and the window holding it has a hard limit in tokens.\n\nPosition inside that window matters: models use what sits at the start and the end of a long context far more reliably than what is buried in the middle.",
        "visible": true,
        "wrap": true

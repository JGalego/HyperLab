      "script": "",
      "properties": {
        "enabled": true,
        "locked": true,
        "style": "transparent",
        "text": "Sampling is a stage after the model, and the scores it is handed do not change. Temperature divides them before the softmax: under one sharpens the distribution toward the top candidates, over one flattens it. Top-p keeps the smallest set of tokens whose probability sums to p.\n\nTurning it down buys consistency. Truthfulness is not on this dial.",
        "visible": true,
        "wrap": true
      },

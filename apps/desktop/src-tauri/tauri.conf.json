{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HyperLab",
  "version": "0.1.0",
  "identifier": "org.hyperlab.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HyperLab",
        "width": 960,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "An AI-native successor to HyperCard",
    "longDescription": "Build desktop applications out of cards, fields, buttons and scripts."
  }
}
